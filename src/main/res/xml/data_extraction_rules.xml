<?xml version="1.0" encoding="utf-8"?>
<!--
    The word database and the import marker must travel together: restoring only
    shared_prefs/import.xml would make Importer believe the data is already imported
    while the database is missing, leaving the app empty forever.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="dictionary"/>
        <include domain="sharedpref" path="import.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="dictionary"/>
        <include domain="sharedpref" path="import.xml"/>
    </device-transfer>
</data-extraction-rules>
