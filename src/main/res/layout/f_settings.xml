<?xml version="1.0" encoding="utf-8"?>
<!-- Settings list. One item for now: cards order mode. Add more rows below. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="@dimen/about_layout_padding"
    android:background="?android:attr/colorBackground">

    <RelativeLayout
        android:id="@+id/setting_order"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/about_items_padding"
        android:paddingBottom="@dimen/about_items_padding"
        android:paddingStart="@dimen/about_items_padding_left"
        android:paddingEnd="@dimen/about_items_padding_left"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/order_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="@dimen/about_items_padding_left"
            android:contentDescription="@string/settings_order_title"/>

        <TextView
            android:id="@+id/order_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/order_switch"
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textSize="@dimen/settings_title_text_size"
            android:text="@string/settings_order_title"/>

        <TextView
            android:id="@+id/order_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/order_title"
            android:layout_alignStart="@id/order_title"
            android:layout_toStartOf="@id/order_switch"
            android:layout_marginTop="@dimen/settings_description_margin_top"
            android:textSize="@dimen/settings_description_text_size"
            android:lineSpacingMultiplier="1.1"/>

    </RelativeLayout>

</LinearLayout>
